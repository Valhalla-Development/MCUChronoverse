# ================================
# 🌐 Application Configuration
# ================================

# Public base URL used for authentication redirects.
# Use http://localhost:3000 for local development.
SITE_URL=http://localhost:3000

# ================================
# 🗄️ Supabase Authentication
# ================================

# Supabase project URL, found in Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key, found in Project Settings > API.
# Safe to expose to the browser. Never use a secret or service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service-role key used only by the server-side contact rate limiter.
# Never expose this key through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# ================================
# 🛡️ Contact Form Protection
# ================================

# Cloudflare Turnstile site key for the contact form.
# Required when running the production build.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret key for server-side verification.
# Required in production. Never expose this to the browser.
TURNSTILE_SECRET_KEY=

# Proxy header that the production edge overwrites with the real client address.
# Common values are cf-connecting-ip, x-real-ip, and x-forwarded-for.
TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip

# Random secret of at least 32 characters used to hash client addresses at rest.
CONTACT_RATE_LIMIT_SECRET=

# ================================
# 📝 GitHub Contact Issues
# ================================

# Fine-grained GitHub token with Issues read/write access for the target repository.
# Required if the contact form should create GitHub issues.
GITHUB_ISSUES_TOKEN=

# Repository that receives contact form submissions, in owner/repository format.
GITHUB_ISSUES_REPOSITORY=

# ================================
# 🔑 Data Enrichment
# ================================

# TMDB read access token for the developer-only metadata enrichment script.
# Required only when running: bun run data:enrich
TMDB_READ_ACCESS_TOKEN=

# Trakt API client ID used to resolve stable title links during metadata enrichment.
# Required only when running: bun run data:enrich
TRAKT_CLIENT_ID=
